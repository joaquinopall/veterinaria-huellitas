# ─────────────────────────────────────────────────────────────
# Copiá este archivo como .env.local y completá los valores.
# NUNCA subas .env.local a GitHub.
# Solo las variables NEXT_PUBLIC_* llegan al navegador.
# ─────────────────────────────────────────────────────────────

# ── Sitio ────────────────────────────────────────────────────
# URL pública (se usa para SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Base de datos (Supabase → Project Settings → Database) ──
# Conexión vía pooler (modo transacción, puerto 6543): la usa la app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Conexión directa/sesión (puerto 5432): la usa Prisma para migraciones
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Supabase Auth (Supabase → Project Settings → API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave pública: segura en el navegador porque RLS bloquea el acceso a las tablas
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: SOLO servidor. Se usa para invitar usuarios desde el panel
SUPABASE_SECRET_KEY=

# ── Email (resend.com → API Keys) ────────────────────────────
RESEND_API_KEY=
# Sin dominio propio, Resend solo permite este remitente de prueba
EMAIL_FROM="Huellitas <onboarding@resend.dev>"

# ── Antispam: Cloudflare Turnstile ───────────────────────────
# Para desarrollo, Cloudflare ofrece claves de prueba que siempre validan:
#   site key:   1x00000000000000000000AA
#   secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Rate limit: Upstash Redis (console.upstash.com) ──────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Texto aleatorio largo para anonimizar IPs (ej: `openssl rand -hex 32`)
IP_HASH_SALT=

# ── Cron (Vercel lo envía como "Authorization: Bearer ...") ──
CRON_SECRET=
